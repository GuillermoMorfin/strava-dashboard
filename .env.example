# Copy to .env and fill in. Get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Port for the local OAuth callback (http://localhost:<port>/callback)
STRAVA_REDIRECT_PORT=8765

# Where data and tokens live
STRAVA_DB_PATH=data/strava.duckdb
STRAVA_TOKEN_PATH=.strava_tokens.json

# Display units: mi or km
STRAVA_UNITS=mi

# Heart rate settings for training load (TRIMP). MAX_HR falls back to the
# highest max HR seen in your activities when left blank.
MAX_HR=
RESTING_HR=60
